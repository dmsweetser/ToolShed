# Wallet Configuration
PRIVATE_KEY=your_eth_wallet_private_key_here
WALLET_ADDRESS=your_eth_wallet_address_here

# Blockchain Configuration
BLOCKCHAIN_NETWORK=arbitrum
RPC_URL=https://arbitrum-mainnet.public.blastapi.io
CHAIN_ID=42161

# Uniswap Configuration
UNISWAP_VERSION=v3
UNISWAP_ROUTER_ADDRESS=0xE592427A0AEce92De3Edee1F18E0157C05861564

# Trading Configuration
STARTING_ETH=0.01
TRADE_AMOUNT_PERCENT=10
MIN_TRADE_AMOUNT_ETH=0.001
MAX_TRADES=5
MIN_PROFIT_PERCENT=0.5
MAX_SLIPPAGE=0.5
MAX_GAS_PRICE=500
GAS_LIMIT=300000

# USDC Configuration
USDC_PROFIT_TARGET=1.0
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1

# Pattern Detection
PATTERN_MODE=both
MIN_PRICE_CHANGE=1.0
MIN_TIME_WINDOW=5
