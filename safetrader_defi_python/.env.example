# App Settings
APP_VERSION=2.0.0-PREPROD
NETWORK=arbitrum
PRIMARY_PRICE_SOURCE=arbitrum
IS_TEST_MODE=true

# Trading Patterns & Limits
BUY_PATTERNS=<_-0.1_5-300
SELL_PATTERNS=>_+0.1_5-300
TOTAL_TRADE_CAPITAL=200
MIN_TRADE_AMOUNT=0.5
TRADE_STEP=3.0
PROFIT_ADDRESS=
MAX_TRADES=5
STOP_LOSS=2
TAKE_PROFIT=5
TRAILING_STOP=1
TOKENS=
TRADE_COOLDOWN=60

# Price & Gas Settings
PRICE_INTERVAL=5000
MAX_PRICE_AGE=30
SLIPPAGE=0.5
MAX_GAS_PRICE=200
GAS_LIMIT=500000
MAX_PRICE_IMPACT=1

# Debug & Backup
DEBUG_MODE=none
AUTO_BACKUP=true
BACKUP_INTERVAL=30
ENCRYPTION_ENABLED=false

# RPC Endpoints
RPC_ARBITRUM_WS=wss://arb1.arbitrum.io/ws
RPC_ARBITRUM_HTTP=https://arb1.arbitrum.io/rpc
RPC_ETHEREUM_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_ETHEREUM_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_BASE_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_BASE_HTTP=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_OPTIMISM_WS=wss://optimism-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_OPTIMISM_HTTP=https://optimism-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_POLYGON_WS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_POLYGON_HTTP=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# API Keys
COINGECKO_API_KEY=
PRIVATE_KEY=