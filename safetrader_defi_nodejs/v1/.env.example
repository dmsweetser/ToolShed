# Uniswap Quick Swap Trader Configuration

# Ethereum Wallet Private Key (REQUIRED for live trading)
# If not present, the app will run in paper trading mode
PRIVATE_KEY=your_wallet_private_key_here

# Blockchain Network Configuration
BLOCKCHAIN_NETWORK=arbitrum
UNISWAP_VERSION=v3

# RPC Endpoints (WebSocket URLs for Arbitrum)
RPC_URL_1=wss://arbitrum-one-rpc.publicnode.com
RPC_URL_2=wss://arb1.arbitrum.io/ws
RPC_URL_3=wss://arbitrum-mainnet.public.blastapi.io

# Arbitrum Chain Configuration
CHAIN_ID=42161
FACTORY_ADDRESS=0x1F98431c8aD98523631AE4a59f267346ea31F984
WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1

# Trading Configuration
STARTING_ETH=0.01
TRADE_AMOUNT_PERCENT=10
MIN_TRADE_AMOUNT_ETH=0.001
MAX_TRADES=10
MIN_PROFIT_PERCENT=0.5
MAX_SLIPPAGE=0.5
MAX_GAS_PRICE=500
GAS_LIMIT=300000

# Pattern Detection Configuration
WINDOW_SIZE=90
MARGIN_OF_ERROR=3
REGRESSION_DEGREE=3
PREDICTION_VALIDATION_COUNT=3
MIN_PREDICTION_ACCURACY=95
PRICE_HISTORY_DURATION=24
MAX_PRICE_HISTORY=1000

# Server Configuration
PORT=3000
SQLITE_PATH=./db/trader.db

# Feature Flags
PAPER_TRADING=true
AUTO_RECONNECT=true
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY=1000